# Конфиг веб-клиента Firebase (Project settings → General → Your apps).
# Без этих переменных используется текущий проект ciu-hangout-app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 1 — всегда демо-режим с данными в памяти (без Firebase).
VITE_DEMO=

# 1 — подключиться к локальным эмуляторам (firebase emulators:start).
VITE_USE_EMULATORS=
